<?xml version="1.0"?>
<launch>
  <arg name="config_path" default="config/da_livgs_geode_gamma_balanced.yaml" />
  <arg name="result_path" default="$(optenv DA_LIVGS_OUTPUT_ROOT /tmp/da_livgs_outputs)/geode-flat-surfaces-smooth" />
  <arg name="save_depth_completion_override" default="-1" />
  <arg name="map_guard_observer_override" default="-1" />
  <arg name="map_guard_enforcement_override" default="-1" />
  <arg name="map_guard_enforcement_mode_override" default="-1" />
  <arg name="map_guard_confidence_mode_override" default="-1" />
  <arg name="mapping_update_response_observer_override" default="-1" />
  <arg name="mapping_update_response_minimum_held_out_views_override" default="-1" />
  <arg name="mapping_update_response_maximum_held_out_views_override" default="-1" />
  <arg name="mapping_update_response_every_n_updates_override" default="-1" />
  <arg name="mapping_update_response_lpips_override" default="-1" />
  <arg name="frequency_balanced_loss_override" default="-1" />
  <arg name="frequency_low_weight_override" default="-1.0" />
  <arg name="frequency_gradient_weight_override" default="-1.0" />
  <arg name="frequency_charbonnier_epsilon_override" default="-1.0" />
  <arg name="mip_filter_override" default="-1" />
  <arg name="mip_filter_kernel_variance_override" default="-1.0" />
  <arg name="apply_exposure_override" default="-1" />
  <arg name="appearance_conditioner_override" default="-1" />
  <arg name="appearance_architecture_mode_override" default="-1" />
  <arg name="appearance_factor_rank_override" default="-1" />
  <arg name="appearance_embedding_dimension_override" default="-1" />
  <arg name="appearance_gaussian_feature_dimension_override" default="-1" />
  <arg name="appearance_gaussian_fourier_frequencies_override" default="-1" />
  <arg name="appearance_hidden_dimension_override" default="-1" />
  <arg name="appearance_knot_interval_frames_override" default="-1" />
  <arg name="appearance_maximum_knots_override" default="-1" />
  <arg name="appearance_residual_scale_override" default="-1.0" />
  <arg name="appearance_gaussian_feature_lr_override" default="-1.0" />
  <arg name="appearance_embedding_lr_override" default="-1.0" />
  <arg name="appearance_mlp_lr_override" default="-1.0" />
  <arg name="appearance_timing_observer_override" default="-1" />
  <arg name="appearance_timing_sample_interval_override" default="-1" />
  <arg name="appearance_timing_maximum_samples_override" default="-1" />
  <arg name="appearance_execution_scheduler_override" default="-1" />
  <arg name="appearance_execution_dense_until_gaussians_override" default="-1" />
  <arg name="appearance_execution_sparse_interval_calls_override" default="-1" />
  <arg name="appearance_execution_sparse_anchor_views_override" default="-1" />
  <arg name="appearance_execution_sparse_anchor_selection_mode_override" default="-1" />
  <arg name="appearance_execution_skipped_render_mode_override" default="-1" />
  <arg name="exposure_mode_override" default="-1" />
  <arg name="exposure_conditioning_mode_override" default="-1" />
  <arg name="exposure_knot_interval_frames_override" default="-1" />
  <arg name="exposure_maximum_knots_override" default="-1" />
  <arg name="exposure_identity_regularization_weight_override" default="-1.0" />
  <arg name="exposure_temporal_smoothness_weight_override" default="-1.0" />
  <arg name="exposure_adaptive_dssim_override" default="-1" />
  <arg name="exposure_adaptive_dssim_maximum_weight_override" default="-1.0" />
  <arg name="exposure_adaptive_dssim_activation_override" default="-1.0" />
  <arg name="exposure_adaptive_dssim_gradient_mode_override" default="-1" />
  <arg name="exposure_adaptive_dssim_execution_mode_override" default="-1" />

  <node pkg="da_livgs_mapping" type="da_livgs_mapping" name="da_livgs_mapping" output="screen" required="true">
    <param name="config_path" type="string" value="$(find da_livgs_mapping)/$(arg config_path)" />
    <param name="result_path" type="string" value="$(arg result_path)" />
    <param name="save_depth_completion_override" type="int" value="$(arg save_depth_completion_override)" />
    <param name="lpips_path" type="string" value="$(find da_livgs_mapping)/src/lpips" />
    <param name="map_guard_observer_override" type="int" value="$(arg map_guard_observer_override)" />
    <param name="map_guard_enforcement_override" type="int" value="$(arg map_guard_enforcement_override)" />
    <param name="map_guard_enforcement_mode_override" type="int" value="$(arg map_guard_enforcement_mode_override)" />
    <param name="map_guard_confidence_mode_override" type="int" value="$(arg map_guard_confidence_mode_override)" />
    <param name="mapping_update_response_observer_override" type="int" value="$(arg mapping_update_response_observer_override)" />
    <param name="mapping_update_response_minimum_held_out_views_override" type="int" value="$(arg mapping_update_response_minimum_held_out_views_override)" />
    <param name="mapping_update_response_maximum_held_out_views_override" type="int" value="$(arg mapping_update_response_maximum_held_out_views_override)" />
    <param name="mapping_update_response_every_n_updates_override" type="int" value="$(arg mapping_update_response_every_n_updates_override)" />
    <param name="mapping_update_response_lpips_override" type="int" value="$(arg mapping_update_response_lpips_override)" />
    <param name="frequency_balanced_loss_override" type="int" value="$(arg frequency_balanced_loss_override)" />
    <param name="frequency_low_weight_override" type="double" value="$(arg frequency_low_weight_override)" />
    <param name="frequency_gradient_weight_override" type="double" value="$(arg frequency_gradient_weight_override)" />
    <param name="frequency_charbonnier_epsilon_override" type="double" value="$(arg frequency_charbonnier_epsilon_override)" />
    <param name="mip_filter_override" type="int" value="$(arg mip_filter_override)" />
    <param name="mip_filter_kernel_variance_override" type="double" value="$(arg mip_filter_kernel_variance_override)" />
    <param name="apply_exposure_override" type="int" value="$(arg apply_exposure_override)" />
    <param name="appearance_conditioner_override" type="int" value="$(arg appearance_conditioner_override)" />
    <param name="appearance_architecture_mode_override" type="int" value="$(arg appearance_architecture_mode_override)" />
    <param name="appearance_factor_rank_override" type="int" value="$(arg appearance_factor_rank_override)" />
    <param name="appearance_embedding_dimension_override" type="int" value="$(arg appearance_embedding_dimension_override)" />
    <param name="appearance_gaussian_feature_dimension_override" type="int" value="$(arg appearance_gaussian_feature_dimension_override)" />
    <param name="appearance_gaussian_fourier_frequencies_override" type="int" value="$(arg appearance_gaussian_fourier_frequencies_override)" />
    <param name="appearance_hidden_dimension_override" type="int" value="$(arg appearance_hidden_dimension_override)" />
    <param name="appearance_knot_interval_frames_override" type="int" value="$(arg appearance_knot_interval_frames_override)" />
    <param name="appearance_maximum_knots_override" type="int" value="$(arg appearance_maximum_knots_override)" />
    <param name="appearance_residual_scale_override" type="double" value="$(arg appearance_residual_scale_override)" />
    <param name="appearance_gaussian_feature_lr_override" type="double" value="$(arg appearance_gaussian_feature_lr_override)" />
    <param name="appearance_embedding_lr_override" type="double" value="$(arg appearance_embedding_lr_override)" />
    <param name="appearance_mlp_lr_override" type="double" value="$(arg appearance_mlp_lr_override)" />
    <param name="appearance_timing_observer_override" type="int" value="$(arg appearance_timing_observer_override)" />
    <param name="appearance_timing_sample_interval_override" type="int" value="$(arg appearance_timing_sample_interval_override)" />
    <param name="appearance_timing_maximum_samples_override" type="int" value="$(arg appearance_timing_maximum_samples_override)" />
    <param name="appearance_execution_scheduler_override" type="int" value="$(arg appearance_execution_scheduler_override)" />
    <param name="appearance_execution_dense_until_gaussians_override" type="int" value="$(arg appearance_execution_dense_until_gaussians_override)" />
    <param name="appearance_execution_sparse_interval_calls_override" type="int" value="$(arg appearance_execution_sparse_interval_calls_override)" />
    <param name="appearance_execution_sparse_anchor_views_override" type="int" value="$(arg appearance_execution_sparse_anchor_views_override)" />
    <param name="appearance_execution_sparse_anchor_selection_mode_override" type="int" value="$(arg appearance_execution_sparse_anchor_selection_mode_override)" />
    <param name="appearance_execution_skipped_render_mode_override" type="int" value="$(arg appearance_execution_skipped_render_mode_override)" />
    <param name="exposure_mode_override" type="int" value="$(arg exposure_mode_override)" />
    <param name="exposure_conditioning_mode_override" type="int" value="$(arg exposure_conditioning_mode_override)" />
    <param name="exposure_knot_interval_frames_override" type="int" value="$(arg exposure_knot_interval_frames_override)" />
    <param name="exposure_maximum_knots_override" type="int" value="$(arg exposure_maximum_knots_override)" />
    <param name="exposure_identity_regularization_weight_override" type="double" value="$(arg exposure_identity_regularization_weight_override)" />
    <param name="exposure_temporal_smoothness_weight_override" type="double" value="$(arg exposure_temporal_smoothness_weight_override)" />
    <param name="exposure_adaptive_dssim_override" type="int" value="$(arg exposure_adaptive_dssim_override)" />
    <param name="exposure_adaptive_dssim_maximum_weight_override" type="double" value="$(arg exposure_adaptive_dssim_maximum_weight_override)" />
    <param name="exposure_adaptive_dssim_activation_override" type="double" value="$(arg exposure_adaptive_dssim_activation_override)" />
    <param name="exposure_adaptive_dssim_gradient_mode_override" type="int" value="$(arg exposure_adaptive_dssim_gradient_mode_override)" />
    <param name="exposure_adaptive_dssim_execution_mode_override" type="int" value="$(arg exposure_adaptive_dssim_execution_mode_override)" />
  </node>
</launch>
