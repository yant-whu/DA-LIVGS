<?xml version="1.0"?>
<launch>
  <arg name="config_path" default="config/da_livgs_fastlivo2_balanced.yaml" />
  <arg name="result_path" default="$(optenv DA_LIVGS_OUTPUT_ROOT /tmp/da_livgs_outputs)/balanced" />
  <arg name="lpips_path" default="$(find da_livgs_mapping)/src/lpips" />
  <arg name="random_seed_override" default="12345" />
  <arg name="sh_degree_override" default="1" />
  <arg name="camera_payload_tiering_override" default="1" />
  <arg name="apply_exposure_override" default="0" />
  <arg name="appearance_conditioner_override" default="1" />
  <node pkg="da_livgs_mapping" type="da_livgs_mapping" name="da_livgs_mapping" output="screen" required="true">
    <param name="config_path" type="string" value="$(find da_livgs_mapping)/$(arg config_path)" />
    <param name="result_path" type="string" value="$(arg result_path)" />
    <param name="lpips_path" type="string" value="$(arg lpips_path)" />
    <param name="random_seed_override" type="int" value="$(arg random_seed_override)" />
    <param name="sh_degree_override" type="int" value="$(arg sh_degree_override)" />
    <param name="camera_payload_tiering_override" type="int" value="$(arg camera_payload_tiering_override)" />
    <param name="apply_exposure_override" type="int" value="$(arg apply_exposure_override)" />
    <param name="appearance_conditioner_override" type="int" value="$(arg appearance_conditioner_override)" />
  </node>
</launch>
