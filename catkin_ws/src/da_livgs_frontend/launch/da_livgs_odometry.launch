<?xml version="1.0"?>
<launch>
  <arg name="project_path"       default = "" />
  <arg name="config_path"       default = "/config/da_livgs_r3live.yaml" />
  <arg name="bag_path"          default = "" />  
  <arg name="odometry_mode_override" default = "-1" />
  <arg name="if_3dgs_override" default = "1" />
  <arg name="bag_start_override" default = "-1.0" />
  <arg name="bag_durr_override" default = "-2.0" />
  <arg name="diagnostics_override" default = "1" />
  <arg name="diagnostics_path_override" default = "" />
  <arg name="adaptive_fusion_override" default = "0" />
  <arg name="adaptive_fusion_mode_override" default = "-1" />
  <arg name="adaptive_fusion_warmup_frames_override" default = "120" />
  <arg name="adaptive_fusion_minimum_visual_samples_override" default = "50" />
  <arg name="compact_pnp_override" default = "0" />
  <arg name="support_conditioned_factor_override" default = "1" />
  <arg name="persistent_degeneracy_shadow_override" default = "-1" />
  <arg name="persistent_degeneracy_action_override" default = "-1" />
  <arg name="mapping_backpressure_override" default = "1" />
  <arg name="mapping_backpressure_timeout_seconds_override" default = "120.0" />
  <arg name="directional_fusion_override" default = "0" />
  <arg name="directional_fusion_mode_override" default = "6" />
  <arg name="tracking_preprocess_mode_override" default = "-1" />
  <arg name="tracking_point_selection_mode_override" default = "-1" />
  <arg name="tracking_forward_backward_override" default = "-1" />
  <arg name="tracking_forward_backward_max_error_override" default = "-1.0" />
  <arg name="directional_minimum_visual_weight_override" default = "-1.0" />
  <arg name="directional_activation_enter_score_override" default = "-1.0" />
  <arg name="directional_activation_exit_score_override" default = "-1.0" />
  <arg name="directional_activation_enter_frames_override" default = "-1" />
  <arg name="directional_activation_exit_frames_override" default = "-1" />
  <arg name="directional_minimum_output_rank_override" default = "-1" />
  <arg name="directional_minimum_trace_ratio_override" default = "-1.0" />
  <arg name="directional_safety_trace_zero_override" default = "0.25" />
  <arg name="directional_safety_trace_full_override" default = "0.4" />
  <arg name="directional_safety_alpha_override" default = "0.2" />
  <arg name="directional_safety_fall_alpha_override" default = "1.0" />
  <arg name="gaussian_feedback_shadow_override" default = "0" />
  <arg name="gaussian_feedback_shadow_maximum_staleness_ms_override" default = "100.0" />
  <arg name="gaussian_feedback_shadow_linger_seconds_override" default = "12.0" />
  <arg name="gaussian_feedback_shadow_log_path_override" default = "" />
  <arg name="gaussian_feedback_transport_shadow_override" default = "0" />
  <arg name="gaussian_feedback_transport_maximum_source_age_ms_override" default = "800.0" />
  <arg name="gaussian_feedback_transport_state_ttl_ms_override" default = "1200.0" />
  <arg name="gaussian_feedback_transport_state_alpha_override" default = "0.2" />
  <arg name="gaussian_endpoint_prior_shadow_override" default = "0" />
  <arg name="gaussian_endpoint_prior_allow_validation_override" default = "0" />
  <arg name="gaussian_endpoint_prior_maximum_source_age_ms_override" default = "650.0" />
  <arg name="gaussian_endpoint_prior_minimum_confidence_override" default = "0.3" />
  <arg name="gaussian_endpoint_prior_minimum_consecutive_accepted_override" default = "3" />
  <arg name="gaussian_endpoint_prior_gain_override" default = "1.0" />
  <arg name="gaussian_endpoint_factor_override" default = "0" />
  <arg name="gaussian_endpoint_factor_apply_override" default = "0" />
  <arg name="gaussian_endpoint_factor_validation_only_override" default = "1" />
  <arg name="gaussian_endpoint_factor_maximum_application_age_ms_override" default = "250.0" />
  <arg name="gaussian_endpoint_factor_rotation_sqrt_information_override" default = "0.05" />
  <arg name="gaussian_endpoint_factor_translation_sqrt_information_override" default = "0.05" />
  <arg name="gaussian_endpoint_factor_log_path_override" default = "" />
  <arg name="gaussian_endpoint_replay_override" default = "0" />
  <arg name="gaussian_endpoint_replay_path_override" default = "" />
  <arg name="gaussian_endpoint_replay_log_path_override" default = "" />
  <arg name="gaussian_endpoint_trust_region_override" default = "0" />
  <arg name="gaussian_endpoint_trust_region_apply_override" default = "0" />
  <arg name="gaussian_endpoint_trust_region_log_path_override" default = "" />
  <arg name="gaussian_mapping_pose_overlay_override" default = "0" />
  <arg name="gaussian_mapping_pose_overlay_recovery_override" default = "1" />
  <arg name="gaussian_mapping_pose_overlay_validation_corruption_override" default = "0" />
  <arg name="gaussian_mapping_pose_overlay_source_override" default = "0" />
  <arg name="gaussian_mapping_pose_overlay_candidate_gain_override" default = "1.0" />
  <arg name="gaussian_mapping_pose_overlay_candidate_rotation_gain_ratio_override" default = "1.0" />
  <arg name="gaussian_mapping_pose_overlay_candidate_translation_cap_metres_override" default = "0.0" />
  <arg name="gaussian_mapping_pose_overlay_candidate_minimum_confidence_override" default = "0.0" />
  <arg name="gaussian_mapping_pose_overlay_application_mask_override" default = "7" />
  <arg name="gaussian_mapping_pose_overlay_independent_application_masks_override" default = "0" />
  <arg name="gaussian_mapping_pose_overlay_recovery_application_mask_override" default = "7" />
  <arg name="gaussian_mapping_pose_overlay_corruption_application_mask_override" default = "7" />
  <arg name="gaussian_mapping_pose_overlay_state_timeout_ms_override" default = "1200.0" />
  <arg name="gaussian_mapping_pose_overlay_maximum_translation_metres_override" default = "0.005" />
  <arg name="gaussian_mapping_pose_overlay_maximum_rotation_degrees_override" default = "0.1" />
  <arg name="gaussian_mapping_pose_overlay_maximum_corruption_translation_metres_override" default = "0.05" />
  <arg name="gaussian_mapping_pose_overlay_maximum_corruption_rotation_degrees_override" default = "1.0" />
  <arg name="gaussian_mapping_pose_overlay_path_override" default = "" />
  <arg name="gaussian_mapping_pose_overlay_log_path_override" default = "" />
  <arg name="observability_length_scale" default = "1.0" />
  <arg name="deterministic_seed" default = "12345" />
  <arg name="deterministic_single_thread" default = "true" />
  <arg name="deterministic_map_update" default = "true" />
  <arg name="deterministic_solver_ordering" default = "true" />
  <arg name="pasue_time"        default = "-1" />
  <arg name="verbose"           default = "false" />  
  <arg name="rviz"              default = "false" />
  
  <node pkg="da_livgs_frontend" type="da_livgs_odometry" name="da_livgs_odometry" output="screen" required="true">
    <param name="project_path"     type="string" value="$(find da_livgs_frontend)" />
    <param name="config_path"     type="string" value="$(find da_livgs_frontend)$(arg config_path)" />
    <param name="bag_path"        type="string" value="$(arg bag_path)" />
    <param name="odometry_mode_override" type="int" value="$(arg odometry_mode_override)" />
    <param name="if_3dgs_override" type="int" value="$(arg if_3dgs_override)" />
    <param name="bag_start_override" type="double" value="$(arg bag_start_override)" />
    <param name="bag_durr_override" type="double" value="$(arg bag_durr_override)" />
    <param name="diagnostics_override" type="int" value="$(arg diagnostics_override)" />
    <param name="diagnostics_path_override" type="string" value="$(arg diagnostics_path_override)" />
    <param name="adaptive_fusion_override" type="int" value="$(arg adaptive_fusion_override)" />
    <param name="adaptive_fusion_mode_override" type="int" value="$(arg adaptive_fusion_mode_override)" />
    <param name="adaptive_fusion_warmup_frames_override" type="int" value="$(arg adaptive_fusion_warmup_frames_override)" />
    <param name="adaptive_fusion_minimum_visual_samples_override" type="int" value="$(arg adaptive_fusion_minimum_visual_samples_override)" />
    <param name="compact_pnp_override" type="int" value="$(arg compact_pnp_override)" />
    <param name="support_conditioned_factor_override" type="int" value="$(arg support_conditioned_factor_override)" />
    <param name="persistent_degeneracy_shadow_override" type="int" value="$(arg persistent_degeneracy_shadow_override)" />
    <param name="persistent_degeneracy_action_override" type="int" value="$(arg persistent_degeneracy_action_override)" />
    <param name="mapping_backpressure_override" type="int" value="$(arg mapping_backpressure_override)" />
    <param name="mapping_backpressure_timeout_seconds_override" type="double" value="$(arg mapping_backpressure_timeout_seconds_override)" />
    <param name="directional_fusion_override" type="int" value="$(arg directional_fusion_override)" />
    <param name="directional_fusion_mode_override" type="int" value="$(arg directional_fusion_mode_override)" />
    <param name="tracking_preprocess_mode_override" type="int" value="$(arg tracking_preprocess_mode_override)" />
    <param name="tracking_point_selection_mode_override" type="int" value="$(arg tracking_point_selection_mode_override)" />
    <param name="tracking_forward_backward_override" type="int" value="$(arg tracking_forward_backward_override)" />
    <param name="tracking_forward_backward_max_error_override" type="double" value="$(arg tracking_forward_backward_max_error_override)" />
    <param name="directional_minimum_visual_weight_override" type="double" value="$(arg directional_minimum_visual_weight_override)" />
    <param name="directional_activation_enter_score_override" type="double" value="$(arg directional_activation_enter_score_override)" />
    <param name="directional_activation_exit_score_override" type="double" value="$(arg directional_activation_exit_score_override)" />
    <param name="directional_activation_enter_frames_override" type="int" value="$(arg directional_activation_enter_frames_override)" />
    <param name="directional_activation_exit_frames_override" type="int" value="$(arg directional_activation_exit_frames_override)" />
    <param name="directional_minimum_output_rank_override" type="int" value="$(arg directional_minimum_output_rank_override)" />
    <param name="directional_minimum_trace_ratio_override" type="double" value="$(arg directional_minimum_trace_ratio_override)" />
    <param name="directional_safety_trace_zero_override" type="double" value="$(arg directional_safety_trace_zero_override)" />
    <param name="directional_safety_trace_full_override" type="double" value="$(arg directional_safety_trace_full_override)" />
    <param name="directional_safety_alpha_override" type="double" value="$(arg directional_safety_alpha_override)" />
    <param name="directional_safety_fall_alpha_override" type="double" value="$(arg directional_safety_fall_alpha_override)" />
    <param name="gaussian_feedback_shadow_override" type="int" value="$(arg gaussian_feedback_shadow_override)" />
    <param name="gaussian_feedback_shadow_maximum_staleness_ms_override" type="double" value="$(arg gaussian_feedback_shadow_maximum_staleness_ms_override)" />
    <param name="gaussian_feedback_shadow_linger_seconds_override" type="double" value="$(arg gaussian_feedback_shadow_linger_seconds_override)" />
    <param name="gaussian_feedback_shadow_log_path_override" type="string" value="$(arg gaussian_feedback_shadow_log_path_override)" />
    <param name="gaussian_feedback_transport_shadow_override" type="int" value="$(arg gaussian_feedback_transport_shadow_override)" />
    <param name="gaussian_feedback_transport_maximum_source_age_ms_override" type="double" value="$(arg gaussian_feedback_transport_maximum_source_age_ms_override)" />
    <param name="gaussian_feedback_transport_state_ttl_ms_override" type="double" value="$(arg gaussian_feedback_transport_state_ttl_ms_override)" />
    <param name="gaussian_feedback_transport_state_alpha_override" type="double" value="$(arg gaussian_feedback_transport_state_alpha_override)" />
    <param name="gaussian_endpoint_prior_shadow_override" type="int" value="$(arg gaussian_endpoint_prior_shadow_override)" />
    <param name="gaussian_endpoint_prior_allow_validation_override" type="int" value="$(arg gaussian_endpoint_prior_allow_validation_override)" />
    <param name="gaussian_endpoint_prior_maximum_source_age_ms_override" type="double" value="$(arg gaussian_endpoint_prior_maximum_source_age_ms_override)" />
    <param name="gaussian_endpoint_prior_minimum_confidence_override" type="double" value="$(arg gaussian_endpoint_prior_minimum_confidence_override)" />
    <param name="gaussian_endpoint_prior_minimum_consecutive_accepted_override" type="int" value="$(arg gaussian_endpoint_prior_minimum_consecutive_accepted_override)" />
    <param name="gaussian_endpoint_prior_gain_override" type="double" value="$(arg gaussian_endpoint_prior_gain_override)" />
    <param name="gaussian_endpoint_factor_override" type="int" value="$(arg gaussian_endpoint_factor_override)" />
    <param name="gaussian_endpoint_factor_apply_override" type="int" value="$(arg gaussian_endpoint_factor_apply_override)" />
    <param name="gaussian_endpoint_factor_validation_only_override" type="int" value="$(arg gaussian_endpoint_factor_validation_only_override)" />
    <param name="gaussian_endpoint_factor_maximum_application_age_ms_override" type="double" value="$(arg gaussian_endpoint_factor_maximum_application_age_ms_override)" />
    <param name="gaussian_endpoint_factor_rotation_sqrt_information_override" type="double" value="$(arg gaussian_endpoint_factor_rotation_sqrt_information_override)" />
    <param name="gaussian_endpoint_factor_translation_sqrt_information_override" type="double" value="$(arg gaussian_endpoint_factor_translation_sqrt_information_override)" />
    <param name="gaussian_endpoint_factor_log_path_override" type="string" value="$(arg gaussian_endpoint_factor_log_path_override)" />
    <param name="gaussian_endpoint_replay_override" type="int" value="$(arg gaussian_endpoint_replay_override)" />
    <param name="gaussian_endpoint_replay_path_override" type="string" value="$(arg gaussian_endpoint_replay_path_override)" />
    <param name="gaussian_endpoint_replay_log_path_override" type="string" value="$(arg gaussian_endpoint_replay_log_path_override)" />
    <param name="gaussian_endpoint_trust_region_override" type="int" value="$(arg gaussian_endpoint_trust_region_override)" />
    <param name="gaussian_endpoint_trust_region_apply_override" type="int" value="$(arg gaussian_endpoint_trust_region_apply_override)" />
    <param name="gaussian_endpoint_trust_region_log_path_override" type="string" value="$(arg gaussian_endpoint_trust_region_log_path_override)" />
    <param name="gaussian_mapping_pose_overlay_override" type="int" value="$(arg gaussian_mapping_pose_overlay_override)" />
    <param name="gaussian_mapping_pose_overlay_recovery_override" type="int" value="$(arg gaussian_mapping_pose_overlay_recovery_override)" />
    <param name="gaussian_mapping_pose_overlay_validation_corruption_override" type="int" value="$(arg gaussian_mapping_pose_overlay_validation_corruption_override)" />
    <param name="gaussian_mapping_pose_overlay_source_override" type="int" value="$(arg gaussian_mapping_pose_overlay_source_override)" />
    <param name="gaussian_mapping_pose_overlay_candidate_gain_override" type="double" value="$(arg gaussian_mapping_pose_overlay_candidate_gain_override)" />
    <param name="gaussian_mapping_pose_overlay_candidate_rotation_gain_ratio_override" type="double" value="$(arg gaussian_mapping_pose_overlay_candidate_rotation_gain_ratio_override)" />
    <param name="gaussian_mapping_pose_overlay_candidate_translation_cap_metres_override" type="double" value="$(arg gaussian_mapping_pose_overlay_candidate_translation_cap_metres_override)" />
    <param name="gaussian_mapping_pose_overlay_candidate_minimum_confidence_override" type="double" value="$(arg gaussian_mapping_pose_overlay_candidate_minimum_confidence_override)" />
    <param name="gaussian_mapping_pose_overlay_application_mask_override" type="int" value="$(arg gaussian_mapping_pose_overlay_application_mask_override)" />
    <param name="gaussian_mapping_pose_overlay_independent_application_masks_override" type="int" value="$(arg gaussian_mapping_pose_overlay_independent_application_masks_override)" />
    <param name="gaussian_mapping_pose_overlay_recovery_application_mask_override" type="int" value="$(arg gaussian_mapping_pose_overlay_recovery_application_mask_override)" />
    <param name="gaussian_mapping_pose_overlay_corruption_application_mask_override" type="int" value="$(arg gaussian_mapping_pose_overlay_corruption_application_mask_override)" />
    <param name="gaussian_mapping_pose_overlay_state_timeout_ms_override" type="double" value="$(arg gaussian_mapping_pose_overlay_state_timeout_ms_override)" />
    <param name="gaussian_mapping_pose_overlay_maximum_translation_metres_override" type="double" value="$(arg gaussian_mapping_pose_overlay_maximum_translation_metres_override)" />
    <param name="gaussian_mapping_pose_overlay_maximum_rotation_degrees_override" type="double" value="$(arg gaussian_mapping_pose_overlay_maximum_rotation_degrees_override)" />
    <param name="gaussian_mapping_pose_overlay_maximum_corruption_translation_metres_override" type="double" value="$(arg gaussian_mapping_pose_overlay_maximum_corruption_translation_metres_override)" />
    <param name="gaussian_mapping_pose_overlay_maximum_corruption_rotation_degrees_override" type="double" value="$(arg gaussian_mapping_pose_overlay_maximum_corruption_rotation_degrees_override)" />
    <param name="gaussian_mapping_pose_overlay_path_override" type="string" value="$(arg gaussian_mapping_pose_overlay_path_override)" />
    <param name="gaussian_mapping_pose_overlay_log_path_override" type="string" value="$(arg gaussian_mapping_pose_overlay_log_path_override)" />
    <param name="observability_length_scale" type="double" value="$(arg observability_length_scale)" />
    <param name="deterministic_seed" type="int" value="$(arg deterministic_seed)" />
    <param name="deterministic_single_thread" type="bool" value="$(arg deterministic_single_thread)" />
    <param name="deterministic_map_update" type="bool" value="$(arg deterministic_map_update)" />
    <param name="deterministic_solver_ordering" type="bool" value="$(arg deterministic_solver_ordering)" />
    <param name="pasue_time"      type="double" value="$(arg pasue_time)" />
    <param name="verbose"         type="bool"   value="$(arg verbose)" />
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz_odom" output="log" required="true" args="-d $(find da_livgs_frontend)/config/coco.rviz" />
</launch>
